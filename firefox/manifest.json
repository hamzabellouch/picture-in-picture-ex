{
  "manifest_version": 3,
  "name": "Picture in Picture",
  "version": "1.0.0",
  "description": "Watch any video using Picture-in-Picture mode.",
  "icons": {
    "128": "assets/icon128.png"
  },
  "action": {
    "default_icon": {
      "19": "assets/icon19.png",
      "38": "assets/icon38.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+P",
        "mac": "Alt+P"
      }
    }
  },
  "permissions": [
    "contextMenus",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "picture-in-picture@tkno",
      "strict_min_version": "109.0"
    }
  }
}
